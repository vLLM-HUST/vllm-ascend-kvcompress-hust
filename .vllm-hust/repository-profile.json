{
  "schema_version": "1.0",
  "canonical_registry": "https://github.com/vLLM-HUST/vllm-hust-docs/tree/codex/ecosystem-architecture-reorganization/registry",
  "repository": "https://github.com/vLLM-HUST/vllm-ascend-kvcompress-hust",
  "repository_role": "runtime_component",
  "relation_to_runtime": "extends_runtime_behavior",
  "lifecycle": "incubating",
  "artifacts": [
    {
      "id": "kvcompress-ascend",
      "artifact_type": "runtime_component",
      "system_role": "kv_state_manager",
      "delivery_model": "plugin_bundle",
      "execution_planes": ["scheduler", "worker", "device"],
      "integration_contracts": [],
      "integration_surfaces": [
        "vllm.general_plugins",
        "vllm.kv_compression.provider",
        "vllm.kv_lifecycle"
