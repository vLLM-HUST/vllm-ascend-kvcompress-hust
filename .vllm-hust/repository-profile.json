  "system_boundaries": {
    "is": [
      "an Ascend runtime component that implements transactional KV compression",
      "a method-neutral compression provider with a separate algorithm registry",
      "a plugin-bundle delivery of scheduler, worker, and device behavior"
    ],
    "is_not": [
      "a KV store, transfer connector, or external state system",
      "a scheduler victim-selection policy",
      "a platform profile or external control plane",
      "a stable typed Bundle v1 materializer"
    ]
  },
  "validation": [
    "python -m pytest -q",
    "ruff check .",
    "ruff format --check .",
    "python -m compileall -q src tests",
    "run matched compression-disabled/enabled long-context workloads on an assigned Ascend NPU"
  ],
  "compatibility_document": "README.md#compatibility"
}
