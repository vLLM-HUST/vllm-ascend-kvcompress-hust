{
  "schema_version": 1,
  "provider": "ascend_kvcompress",
  "method": "triattention",
  "method_config": {
    "stats_path": "/absolute/path/to/model-matched-stats.pt",
    "kv_budget": 8192,
    "recompute_window": 1024,
    "protected_recent_window": 512,
    "score_aggregation": "mean",
    "layer_aggregation": "mean",
    "score_chunk_size": 8192,
    "score_layer_stride": 4,
    "min_output_tokens_for_compression": 64
  }
}
